# pipeline/models.env — model tiers and caps for the continuous build pipeline.
# Provisional until the product owner answers P2/P6 of
# docs/2026-10-07-continuous-build-pipeline.md §9. Sourced by driver.sh.
# Model ids: `opencode models` is the registry; format provider/model[#variant].

# Roles (plan §3.1)
PRINCIPAL_MODEL="alibaba-token-plan/qwen3.8-max#xhigh"
IMPLEMENTER_MODEL="lmstudio/qwen/qwen3.8-27b"
REVIEWER_MODEL="alibaba-token-plan/qwen3.8-flash"
FIXER_MODEL="lmstudio/qwen/qwen3.8-27b"

# Watchdog caps (plan §3.4) — seconds
IMPLEMENTER_TIMEOUT_S=14400   # 4 h per implementer lane
REVIEWER_TIMEOUT_S=7200       # 2 h per review
FIXER_TIMEOUT_S=7200          # 2 h per fix round
MAX_FIX_ROUNDS=2              # then the lane parks for the principal

# Go gate caps (AGENTS.md 2026-09-21: never run uncapped)
export GOMEMLIMIT="512MiB"
GO_TEST_TIMEOUT="300s"

# Throughput caps (plan §7: never outrun the human merge gate H1)
MAX_CONCURRENT_LANES=3
MAX_OPEN_PRS=2
AWAITING_HUMAN_MAX=3
LOOP_SLEEP_S=300

# Small-change discipline (owner directive 2026-10-07): a lane commit whose
# diff exceeds this many changed lines is WARNED in the log (non-fatal) so
# the principal can re-cut the WP into smaller queue entries.
DIFF_WARN_LINES=5000

# loop --for: never start a child stage with less than this many seconds left
MIN_STAGE_S=1800

# Worktrees live OUTSIDE the repo (plan §3.2)
LANES_DIR="$HOME/Sleipnir-lanes"
